diff --git a/fs/proc/dnuma_view.c b/fs/proc/dnuma_view.c
new file mode 100644
index 000000000..777071949
--- /dev/null
+++ b/fs/proc/dnuma_view.c
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * dnuma view: CPUs of other machines, and the work local tasks do on them,
+ * shown in /proc.
+ *
+ * A cluster manager (dnuma-master) moves the execution of ordinary processes
+ * to other machines while the processes themselves stay here: they keep
+ * their pid, their files and their place in the process tree, and sleep
+ * while their code runs elsewhere. Without help, tools show such a process
+ * as idle and know nothing of the CPUs it is using. This file lets the
+ * manager describe both, so that
+ *
+ *   /proc/cpuinfo      lists the remote CPUs after the machine's own,
+ *   /proc/stat         has a "cpuN" line for each (and counts them in "cpu"),
+ *   /proc/<pid>/stat   reports the remote CPU, the running state and the CPU
+ *                      time consumed remotely (and /proc/<pid>/status the
+ *                      state).
+ *
+ * Nothing else changes: the scheduler, the CPU masks, affinity and sysfs
+ * know only the machine's own CPUs, and the kernel's own accounting
+ * (getrusage(), wait4(), cgroups) contains only what ran here.
+ *
+ * Control file: /proc/dnuma_view, mode 0600.
+ *
+ *   read    version 1
+ *           nr_cpu_ids <n>      remote CPU numbers must be >= this
+ *           user_hz <n>         unit of all times written here
+ *           cpus <n>
+ *           tasks <n>
+ *
+ *   write   commands, one per line; a write must hold whole commands:
+ *
+ *           cpu <id> info <nbytes>   defines or replaces CPU <id>; the next
+ *                                    <nbytes> bytes are its /proc/cpuinfo
+ *                                    block, verbatim
+ *           cpu <id> stat <user> <nice> <system> <idle> <iowait> <irq>
+ *                         <softirq> <steal> <guest> <guest_nice>
+ *           cpu <id> del
+ *           task <pid> <cpu|-1> <R|-> <utime> <stime>
+ *                                    <pid> as seen by the writer. R: show
+ *                                    the task as running while it sleeps
+ *                                    here. Times are totals consumed
+ *                                    remotely. Ignored if no such task
+ *                                    exists (any more).
+ *           task <pid> del
+ *           clear
+ *
+ * Commands are applied in order; at the first invalid one the write fails
+ * and the commands before it stay applied. Only one writer can have the file
+ * open, and everything it wrote is discarded when it closes the file, so a
+ * manager that dies takes its view with it. Entries of tasks that have
+ * exited are dropped automatically.
+ */
+#include <linux/cpumask.h>
+#include <linux/dnuma_view.h>
+#include <linux/fs.h>
+#include <linux/hashtable.h>
+#include <linux/init.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/pid.h>
+#include <linux/proc_fs.h>
+#include <linux/rculist.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+/*
+ * Largest single write. A command batch is copied into kernel memory as a
+ * whole, so it has to be bounded; a /proc/cpuinfo block is one or two
+ * kilobytes, and a manager with more to say than this splits it up.
+ */
+#define DV_MAX_WRITE	(1024 * 1024)
+
+DEFINE_STATIC_KEY_FALSE(dnuma_view_key);
+
+struct dv_cpu {
+	struct list_head list;		/* dv_cpus, sorted by id */
+	struct rcu_head rcu;
+	unsigned int id;
+	u64 stat[DNUMA_VIEW_NSTAT];	/* clock ticks; updated in place */
+	size_t info_len;
+	char info[];
+};
+
+struct dv_task {
+	struct hlist_node node;		/* dv_tasks, keyed by the pid pointer */
+	struct rcu_head rcu;
+	struct pid *pid;		/* holds a reference */
+	int cpu;
+	bool running;
+	u64 utime, stime;
+};
+
+/* Writers hold dv_lock; readers walk the structures under RCU. */
+static DEFINE_MUTEX(dv_lock);
+static LIST_HEAD(dv_cpus);
+static unsigned int dv_nr_cpus;
+static DEFINE_HASHTABLE(dv_tasks, 8);
+static unsigned int dv_nr_tasks;
+static struct file *dv_writer;
+
+/* ---- the writer (dv_lock held) ----------------------------------------- */
+
+static struct dv_cpu *dv_find_cpu(unsigned int id)
+{
+	struct dv_cpu *c;
+
+	list_for_each_entry(c, &dv_cpus, list)
+		if (c->id == id)
+			return c;
+	return NULL;
+}
+
+static void dv_del_cpu(struct dv_cpu *c)
+{
+	list_del_rcu(&c->list);
+	WRITE_ONCE(dv_nr_cpus, dv_nr_cpus - 1);
+	kvfree_rcu(c, rcu);
+}
+
+static int dv_set_cpu_info(unsigned int id, const char *text, size_t len)
+{
+	struct dv_cpu *c, *old, *pos;
+
+	/* A remote CPU can never take the number of one this machine may have. */
+	if (id < nr_cpu_ids || id > INT_MAX)
+		return -EINVAL;
+	c = kvzalloc(struct_size(c, info, len), GFP_KERNEL_ACCOUNT);
+	if (!c)
+		return -ENOMEM;
+	c->id = id;
+	c->info_len = len;
+	memcpy(c->info, text, len);
+
+	old = dv_find_cpu(id);
+	if (old) {
+		memcpy(c->stat, old->stat, sizeof(c->stat));
+		list_replace_rcu(&old->list, &c->list);
+		kvfree_rcu(old, rcu);
+		return 0;
+	}
+	list_for_each_entry(pos, &dv_cpus, list)
+		if (pos->id > id)
+			break;
+	/* Before the first larger id, or at the end of the list. */
+	list_add_tail_rcu(&c->list, &pos->list);
+	WRITE_ONCE(dv_nr_cpus, dv_nr_cpus + 1);
+	return 0;
+}
+
+static struct dv_task *dv_find_task(struct pid *pid)
+{
+	struct dv_task *t;
+
+	hash_for_each_possible(dv_tasks, t, node, (unsigned long)pid)
+		if (t->pid == pid)
+			return t;
+	return NULL;
+}
+
+static void dv_task_free_rcu(struct rcu_head *rcu)
+{
+	struct dv_task *t = container_of(rcu, struct dv_task, rcu);
+
+	/*
+	 * Only now, so that no reader can match a recycled struct pid
+	 * against this entry.
+	 */
+	put_pid(t->pid);
+	kfree(t);
+}
+
+static void dv_del_task(struct dv_task *t)
+{
+	hash_del_rcu(&t->node);
+	dv_nr_tasks--;
+	call_rcu(&t->rcu, dv_task_free_rcu);
+}
+
+/* Drops the entries of tasks that no longer exist. */
+static void dv_reap_tasks(void)
+{
+	struct hlist_node *tmp;
+	struct dv_task *t;
+	int bkt;
+
+	hash_for_each_safe(dv_tasks, bkt, tmp, t, node)
+		if (!pid_has_task(t->pid, PIDTYPE_PID))
+			dv_del_task(t);
+}
+
+static int dv_set_task(pid_t nr, int cpu, char state, u64 utime, u64 stime)
+{
+	struct dv_task *t;
+	struct pid *pid;
+
+	if (cpu != -1 && (cpu < 0 || (unsigned int)cpu < nr_cpu_ids))
+		return -EINVAL;
+	if (state != 'R' && state != '-')
+		return -EINVAL;
+
+	/*
+	 * A task can exit at any moment, so one that is already gone is not
+	 * the writer's mistake: there is simply nothing left to describe.
+	 */
+	pid = find_get_pid(nr);
+	if (!pid)
+		return 0;
+	t = dv_find_task(pid);
+	if (!t) {
+		if (!pid_has_task(pid, PIDTYPE_PID)) {
+			put_pid(pid);
+			return 0;
+		}
+		t = kzalloc(sizeof(*t), GFP_KERNEL_ACCOUNT);
+		if (!t) {
+			put_pid(pid);
+			return -ENOMEM;
+		}
+		t->pid = pid;	/* the entry keeps the reference */
+		t->cpu = cpu;
+		t->running = state == 'R';
+		t->utime = utime;
+		t->stime = stime;
+		hash_add_rcu(dv_tasks, &t->node, (unsigned long)pid);
+		dv_nr_tasks++;
+		return 0;
+	}
+	put_pid(pid);
+	WRITE_ONCE(t->cpu, cpu);
+	WRITE_ONCE(t->running, state == 'R');
+	WRITE_ONCE(t->utime, utime);
+	WRITE_ONCE(t->stime, stime);
+	return 0;
+}
+
+static void dv_del_task_nr(pid_t nr)
+{
+	struct pid *pid = find_get_pid(nr);
+	struct dv_task *t;
+
+	if (!pid)
+		return;		/* already gone, and reaped with it */
+	t = dv_find_task(pid);
+	if (t)
+		dv_del_task(t);
+	put_pid(pid);
+}
+
+static void dv_clear(void)
+{
+	struct dv_cpu *c, *ctmp;
+	struct hlist_node *tmp;
+	struct dv_task *t;
+	int bkt;
+
+	list_for_each_entry_safe(c, ctmp, &dv_cpus, list)
+		dv_del_cpu(c);
+	hash_for_each_safe(dv_tasks, bkt, tmp, t, node)
+		dv_del_task(t);
+}
+
+/*
+ * Executes one command. @line is NUL-terminated; *@rest points behind it
+ * and is advanced past any payload the command consumes.
+ */
+static int dv_command(const char *line, const char **rest, const char *end)
+{
+	unsigned long long v[DNUMA_VIEW_NSTAT];
+	unsigned long long utime, stime;
+	unsigned int id;
+	struct dv_cpu *c;
+	size_t len;
+	char state;
+	int pid, cpu;
+	int n, i;
+
+	if (!strcmp(line, "clear")) {
+		dv_clear();
+		return 0;
+	}
+
+	n = 0;
+	if (sscanf(line, "cpu %u info %zu%n", &id, &len, &n) == 2 && n && !line[n]) {
+		int err;
+
+		if (len > end - *rest)
+			return -EINVAL;
+		err = dv_set_cpu_info(id, *rest, len);
+		if (!err)
+			*rest += len;
+		return err;
+	}
+	n = 0;
+	if (sscanf(line, "cpu %u del%n", &id, &n) == 1 && n && !line[n]) {
+		c = dv_find_cpu(id);
+		if (c)
+			dv_del_cpu(c);
+		return 0;
+	}
+	n = 0;
+	if (sscanf(line, "cpu %u stat %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu%n",
+		   &id, &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7],
+		   &v[8], &v[9], &n) == 1 + DNUMA_VIEW_NSTAT && n && !line[n]) {
+		c = dv_find_cpu(id);
+		if (!c)
+			return -ENOENT;
+		for (i = 0; i < DNUMA_VIEW_NSTAT; i++)
+			WRITE_ONCE(c->stat[i], v[i]);
+		return 0;
+	}
+	n = 0;
+	if (sscanf(line, "task %d del%n", &pid, &n) == 1 && n && !line[n]) {
+		dv_del_task_nr(pid);
+		return 0;
+	}
+	n = 0;
+	if (sscanf(line, "task %d %d %c %llu %llu%n", &pid, &cpu, &state, &utime,
+		   &stime, &n) == 5 && n && !line[n])
+		return dv_set_task(pid, cpu, state, utime, stime);
+
+	return -EINVAL;
+}
+
+/* ---- /proc/dnuma_view --------------------------------------------------- */
+
+static ssize_t dv_write(struct file *file, const char __user *ubuf, size_t count,
+			loff_t *ppos)
+{
+	char *buf, *line;
+	const char *end;
+	int err = 0;
+
+	if (!count)
+		return 0;
+	if (count > DV_MAX_WRITE)
+		return -E2BIG;
+	buf = kvmalloc(count + 1, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	if (copy_from_user(buf, ubuf, count)) {
+		kvfree(buf);
+		return -EFAULT;
+	}
+	buf[count] = '\0';
+	end = buf + count;
+
+	mutex_lock(&dv_lock);
+	if (file != dv_writer) {
+		err = -EBADF;
+		goto out;
+	}
+	if (dv_nr_tasks)
+		dv_reap_tasks();
+	for (line = buf; line < end; ) {
+		char *nl = memchr(line, '\n', end - line);
+		const char *rest;
+
+		if (!nl) {
+			err = -EINVAL;	/* incomplete command */
+			break;
+		}
+		*nl = '\0';
+		rest = nl + 1;
+		err = dv_command(line, &rest, end);
+		if (err)
+			break;
+		line = (char *)rest;
+	}
+out:
+	mutex_unlock(&dv_lock);
+	kvfree(buf);
+	return err ? err : count;
+}
+
+static int dv_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "version 1\nnr_cpu_ids %u\nuser_hz %d\ncpus %u\ntasks %u\n",
+		   nr_cpu_ids, USER_HZ, READ_ONCE(dv_nr_cpus), READ_ONCE(dv_nr_tasks));
+	return 0;
+}
+
+static int dv_open(struct inode *inode, struct file *file)
+{
+	int err;
+
+	if (!(file->f_mode & FMODE_WRITE))
+		return single_open(file, dv_show, NULL);
+
+	mutex_lock(&dv_lock);
+	if (dv_writer) {
+		mutex_unlock(&dv_lock);
+		return -EBUSY;
+	}
+	err = single_open(file, dv_show, NULL);
+	if (!err) {
+		dv_writer = file;
+		static_branch_enable(&dnuma_view_key);
+	}
+	mutex_unlock(&dv_lock);
+	return err;
+}
+
+static int dv_release(struct inode *inode, struct file *file)
+{
+	mutex_lock(&dv_lock);
+	if (file == dv_writer) {
+		dv_clear();
+		dv_writer = NULL;
+		static_branch_disable(&dnuma_view_key);
+	}
+	mutex_unlock(&dv_lock);
+	return single_release(inode, file);
+}
+
+static const struct proc_ops dv_proc_ops = {
+	.proc_open	= dv_open,
+	.proc_read_iter	= seq_read_iter,
+	.proc_lseek	= seq_lseek,
+	.proc_write	= dv_write,
+	.proc_release	= dv_release,
+};
+
+static int __init dnuma_view_init(void)
+{
+	if (!proc_create("dnuma_view", 0600, NULL, &dv_proc_ops))
+		return -ENOMEM;
+	return 0;
+}
+fs_initcall(dnuma_view_init);
diff --git a/include/linux/dnuma_view.h b/include/linux/dnuma_view.h
new file mode 100644
index 000000000..70317c824
--- /dev/null
+++ b/include/linux/dnuma_view.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * dnuma view: lets a cluster manager show CPUs of other machines, and the
+ * work its tasks do there, in /proc/cpuinfo, /proc/stat, /proc/<pid>/stat
+ * and /proc/<pid>/status. See fs/proc/dnuma_view.c.
+ */
+#ifndef _LINUX_DNUMA_VIEW_H
+#define _LINUX_DNUMA_VIEW_H
+
+#include <linux/jump_label.h>
+#include <linux/types.h>
+
+/* Fields of a "cpuN" line of /proc/stat, in the order they are printed. */
+#define DNUMA_VIEW_NSTAT 10
+
+#ifdef CONFIG_DNUMA_VIEW
+
+/* True while a manager holds /proc/dnuma_view open for writing. */
+DECLARE_STATIC_KEY_FALSE(dnuma_view_key);
+
+#endif /* CONFIG_DNUMA_VIEW */
+
+#endif /* _LINUX_DNUMA_VIEW_H */
-- 
